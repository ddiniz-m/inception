#Database
MYSQL_ROOT_USER=${MYSQL_ROOT_USER:-$(cat /run/secrets/MYSQLROOTUSER)}
MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD:-$(cat /run/secrets/MYSQLROOTPASSWORD)}

MYSQL_DATABASE=${MYSQL_DATABASE:-$(cat /run/secrets/MYSQLDATABASE)}
MYSQL_USER=${MYSQL_USER:-$(cat /run/secrets/MYSQLUSER)}
MYSQL_PASSWORD=${MYSQL_PASSWORD:-$(cat /run/secrets/MYSQLPASSWORD)}

#Wordpress
WP_URL=${WP_URL:-$(cat /run/secrets/WPURL)}
WP_TITLE=${WP_TITLE:-$(cat /run/secrets/WPTITLE)}

WP_ADMIN_USER=${WP_ADMIN_USER:-$(cat /run/secrets/WPADMINUSER)}
WP_ADMIN_PW=${WP_ADMIN_PW:-$(cat /run/secrets/WPADMINPW)}
WP_ADMIN_EMAIL=${WP_ADMIN_EMAIL:-$(cat /run/secrets/WPADMINEMAIL)}

WP_USER=${WP_USER:-$(cat /run/secrets/WPUSER)}
WP_USER_PASS=${WP_USER_PASS:-$(cat /run/secrets/WPUSERPASS)}
WP_USER_EMAIL=${WP_USER_EMAIL:-$(cat /run/secrets/WPUSEREMAIL)}